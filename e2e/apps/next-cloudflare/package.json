  },
  "dependencies": {
    "@scottjgilbert/lexical-blog-editor": "workspace:*",
    "@scottjgilbert/lexical-blog-editor-ext-callout": "workspace:*",
    "@lexical/react": "^0.40.0",
    "@lexical/utils": "^0.40.0",
    "@opennextjs/cloudflare": "^1.20.7",
    "katex": "^0.16.28",
    "lexical": "^0.40.0",
    "next": "^16.3.8",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "wrangler": "^4"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19.2.13",
    "@types/react-dom": "^19.2.3",
    "typescript": "^5.9.3"
  }
}
