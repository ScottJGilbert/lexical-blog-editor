{
  "name": "@scottjgilbert/lexical-blog-editor",
  "version": "1.1.0",
  "description": "Prebuilt components for editing and rendering rich blog content with Lexical. Modified wrapper of the Lexical Playground editor.",
  "main": "./build/index.js",
  "types": "./build/index.d.ts",
  "repository": {
    "type": "git",
    "url": "https://github.com/ScottJGilbert/lexical-blog-editor.git"
  },
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "import": "./build/index.js",
      "require": "./build/index.js"
    },
    "./viewer": {
      "types": "./build/viewer/index.d.ts",
      "browser": "./build/viewer/client.js",
      "import": "./build/viewer/index.js",
      "require": "./build/viewer/index.js"
    },
    "./styles/ViewerTheme.css": "./build/themes/ViewerTheme.css",
    "./styles/ViewerThemeComplete.css": "./build/themes/ViewerThemeComplete.css"
  },
  "files": [
    "build"
  ],
  "scripts": {
    "build": "tsc && pnpm run copy-assets",
    "copy-assets": "copyfiles -u 1 \"src/**/*.{css,png,jpg,jpeg,gif,svg,webp}\" build/",
    "prepublishOnly": "pnpm run build"
  },
  "keywords": [
    "lexical",
    "editor",
    "react",
    "blog",
    "rich-text"
  ],
  "author": "Scott Gilbert",
  "license": "MIT",
  "peerDependencies": {
    "lexical": "^0.40.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@floating-ui/react": "^0.27.17",
    "@igorskyflyer/strip-html": "^2.1.0",
    "@lexical/clipboard": "^0.40.0",
    "@lexical/code": "^0.40.0",
    "@lexical/code-shiki": "^0.40.0",
    "@lexical/extension": "^0.40.0",
    "@lexical/file": "^0.40.0",
    "@lexical/hashtag": "^0.40.0",
    "@lexical/headless": "^0.40.0",
    "@lexical/html": "^0.40.0",
    "@lexical/link": "^0.40.0",
    "@lexical/list": "^0.40.0",
    "@lexical/mark": "^0.40.0",
    "@lexical/markdown": "^0.40.0",
    "@lexical/overflow": "^0.40.0",
    "@lexical/react": "^0.40.0",
    "@lexical/rich-text": "^0.40.0",
    "@lexical/selection": "^0.40.0",
    "@lexical/table": "^0.40.0",
    "@lexical/utils": "^0.40.0",
    "@lexical/yjs": "^0.40.0",
    "@shikijs/core": "^3.22.0",
    "@shikijs/engine-javascript": "^3.22.0",
    "@shikijs/types": "^3.22.0",
    "date-fns": "^4.1.0",
    "dompurify": "^3.0.6",
    "html-react-parser": "^5.2.16",
    "jsdom": "26.1.0",
    "katex": "^0.16.28",
    "lodash": "^4.17.23",
    "lodash-es": "^4.17.23",
    "prettier": "^3.8.1",
    "react-day-picker": "^9.13.0",
    "react-error-boundary": "^6.1.0",
    "react-tweet": "^3.3.0",
    "shiki": "^3.22.0",
    "y-websocket": "^3.0.0",
    "yjs": "^13.6.29"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "@types/jsdom": "^27.0.0",
    "@types/lodash": "^4.17.23",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^20.19.32",
    "@types/react": "^19.2.13",
    "@types/react-dom": "^19.2.3",
    "copyfiles": "^2.4.1",
    "eslint": "^9.39.2",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@10.28.0+sha512.05df71d1421f21399e053fde567cea34d446fa02c76571441bfc1c7956e98e363088982d940465fd34480d4d90a0668bc12362f8aa88000a64e83d0b0e47be48"
}
