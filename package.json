{
  "name": "lexical-blog-editor-monorepo",
  "private": true,
  "version": "0.0.0",
  "description": "Monorepo for @scottjgilbert/lexical-blog-editor and its extension packages.",
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" run build",
    "typecheck": "pnpm -r --filter \"./packages/*\" run typecheck",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:envs": "vitest run --project node --project jsdom --project edge",
    "test:e2e": "playwright test",
    "ci": "pnpm build && pnpm typecheck && pnpm check:boundaries && pnpm test && pnpm test:e2e"
  },
  "packageManager": "pnpm@10.28.0+sha512.05df71d1421f21399e053fde567cea34d446fa02c76571441bfc1c7956e98e363088982d940465fd34480d4d90a0668bc12362f8aa88000a64e83d0b0e47be48",
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@lexical/code": "^0.40.0",
    "@lexical/extension": "^0.40.0",
    "@lexical/hashtag": "^0.40.0",
    "@lexical/headless": "^0.40.0",
    "@lexical/html": "^0.40.0",
    "@lexical/link": "^0.40.0",
    "@lexical/list": "^0.40.0",
    "@lexical/mark": "^0.40.0",
    "@lexical/overflow": "^0.40.0",
    "@lexical/react": "^0.40.0",
    "@lexical/rich-text": "^0.40.0",
    "@lexical/table": "^0.40.0",
    "@lexical/utils": "^0.40.0",
    "@playwright/test": "^1.63.0",
    "@scottjgilbert/lexical-blog-editor": "workspace:*",
    "@types/express": "^5.0.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.28.2",
    "express": "^5.2.1",
    "jsdom": "^26",
    "lexical": "^0.40",
    "react": "^19",
    "react-dom": "^19",
    "tsup": "^8.5.1",
    "typescript": "^5.9",
    "vitest": "^3.2.7"
  }
}
